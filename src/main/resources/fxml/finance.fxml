<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chemmanager.controller.finance.FinanceController"
      styleClass="content-area" spacing="12">
    <HBox fx:id="kpiRow" spacing="12"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="summaryLabel" text="" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="directionFilter" prefWidth="140"/>
        <ComboBox fx:id="accountFilter" prefWidth="180"/>
        <Button fx:id="newMovementButton" text="%finance.action.new_movement" styleClass="btn, btn-primary, btn-sm"/>
        <Button fx:id="refreshButton" text="%common.refresh" styleClass="btn, btn-secondary, btn-sm"/>
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox spacing="12">
            <VBox fx:id="periodStrip" spacing="8"/>
            <VBox fx:id="tableHost" VBox.vgrow="ALWAYS"/>
        </VBox>
    </ScrollPane>
</VBox>
