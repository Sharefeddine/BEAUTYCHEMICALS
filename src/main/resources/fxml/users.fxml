<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chemmanager.controller.users.UsersController"
      styleClass="content-area" spacing="12">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="summaryLabel" text="" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="%common.refresh" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="exportButton" text="%dashboard.export" styleClass="btn, btn-secondary, btn-sm"/>
    </HBox>
    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox fx:id="tableHost" HBox.hgrow="ALWAYS"/>
        <VBox spacing="8" prefWidth="420" minWidth="360">
            <Label text="%users.roles_title" styleClass="h3"/>
            <Label text="%users.roles_hint" styleClass="text-muted" wrapText="true" style="-fx-font-size: 11px;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="rolesHost" spacing="10" style="-fx-padding: 0 6 0 0;"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
