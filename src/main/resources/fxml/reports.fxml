<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chemmanager.controller.reports.ReportsController"
      styleClass="content-area" spacing="12">
    <HBox fx:id="kpiRow" spacing="12"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="%reports.window" styleClass="text-muted"/>
        <DatePicker fx:id="fromPicker" prefWidth="140"/>
        <DatePicker fx:id="toPicker" prefWidth="140"/>
        <Label text="%reports.period" styleClass="text-muted"/>
        <ComboBox fx:id="periodSelector" prefWidth="130"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text="" styleClass="text-muted"/>
        <Button fx:id="refreshButton" text="%common.refresh" styleClass="btn, btn-secondary, btn-sm"/>
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox spacing="12">
            <VBox fx:id="resultHost" spacing="8"/>
            <VBox fx:id="marginHost" spacing="8"/>
            <VBox fx:id="cashflowHost" spacing="8"/>
        </VBox>
    </ScrollPane>
</VBox>
