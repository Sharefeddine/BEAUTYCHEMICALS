<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chemmanager.controller.formulations.FormulationsController"
      fx:id="contentRoot" styleClass="content-area" spacing="12">
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <ComboBox fx:id="statusFilter" prefWidth="185" promptText="%common.status"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text="" styleClass="text-muted"/>
        <Button fx:id="newButton" text="%formulations.new" styleClass="btn, btn-primary, btn-sm"/>
        <Button fx:id="refreshButton" text="%common.refresh" styleClass="btn, btn-secondary, btn-sm"/>
    </HBox>
    <VBox fx:id="tableHost" VBox.vgrow="ALWAYS"/>
    <VBox fx:id="detailHost" spacing="10"/>
</VBox>
