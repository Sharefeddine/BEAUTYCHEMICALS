<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chemmanager.controller.production.ProductionController"
      styleClass="content-area" spacing="12">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="summaryLabel" text="" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" prefWidth="170"/>
        <Button fx:id="newButton" text="%production.action.new" styleClass="btn, btn-primary, btn-sm"/>
        <Button fx:id="startButton" text="%production.action.start" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="consumeButton" text="%production.action.consume" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="completeButton" text="%production.action.complete" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="qualityButton" text="%production.action.quality" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="genealogyButton" text="%production.action.genealogy" styleClass="btn, btn-secondary, btn-sm"/>
        <Button fx:id="refreshButton" text="%common.refresh" styleClass="btn, btn-secondary, btn-sm"/>
    </HBox>
    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <VBox>
            <VBox fx:id="tableHost" VBox.vgrow="ALWAYS"/>
        </VBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox fx:id="detailHost" spacing="10"/>
        </ScrollPane>
    </SplitPane>
</VBox>
